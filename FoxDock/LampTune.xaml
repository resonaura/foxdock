<Window x:Class="FoxDock.LampTune"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
        xmlns:local="clr-namespace:FoxDock"
        mc:Ignorable="d"
        Title="LampTune" WindowState="Maximized" Height="260" Width="500" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" WindowStyle="None" WindowStartupLocation="CenterScreen">
    <Grid Name="MainGrid" fw:PointerTracker.Enabled="True">
        <Grid.Background>
            <SolidColorBrush Color="#060606" Opacity=".6"></SolidColorBrush>
        </Grid.Background>
        <Border Name="TunePanel" Background="#222" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350" Height="180" CornerRadius="5">
            <Border.Effect>
                <DropShadowEffect Direction="271" BlurRadius="26" ShadowDepth="15" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center" Name="MainDialog">
                <TextBlock Padding="30" Visibility="Collapsed" Width="350" TextWrapping="Wrap" TextAlignment="Center" Foreground="#ddd" HorizontalAlignment="Center" Name="DialogLabel">23</TextBlock>
                <TextBlock Foreground="White" HorizontalAlignment="Center">Яркость</TextBlock>
                <Slider x:Name="BrightSlider" Thumb.DragCompleted="Slider_DragCompleted"  Width="130" Grid.Row="2" Grid.Column="1"  Margin="0,6,0,0" TickFrequency="0.1" Orientation="Horizontal"  Minimum="1" Maximum="100" />
                <TextBlock Foreground="White" HorizontalAlignment="Center">Температура</TextBlock>
                <Slider x:Name="TempSlider" Thumb.DragCompleted="TempSlider_DragCompleted"  Width="130" Grid.Row="2" Grid.Column="1"  Margin="0,6,0,0" TickFrequency="0.1" Orientation="Horizontal"  Minimum="2700" Maximum="6500" />
                <Button Click="ExitButton_Click" Name="ExitButton" Cursor="Hand" Style="{StaticResource ButtonRevealStyle}" Content="Закрыть" Foreground="White" Width="150" Height="35" Margin="5"></Button>
            </StackPanel>
        </Border>

    </Grid>
</Window>
