<Window x:Class="FoxDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FoxDock"
        xmlns:controls="clr-namespace:BlurryControls.Controls;assembly=BlurryControls"
        mc:Ignorable="d"
        Title="FoxDock"  MouseDown="Window_MouseDown" Activated="DockMain_Activated" MouseMove="Draggable_icon_MouseMove" Topmost="True" SizeChanged="Window_SizeChanged" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave" DragEnter="Main_Drop_Enter" DragLeave="Window_DragLeave" Drop="Main_Drop" AllowDrop="True" Height="80" ShowInTaskbar="False" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Icon="icon.ico" WindowStartupLocation="Manual" Top="-100" Name="DockMain">

    <Window.Resources>
        <Style TargetType="Image">
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>
        <Style TargetType="{x:Type ContextMenu}" x:Key="DarkContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Grid.IsSharedSizeScope" Value="true" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border x:Name="Border"
                Background="{TemplateBinding Background }"
                BorderThickness="0">

                            <Border.BorderBrush>
                                <SolidColorBrush Color="Transparent" />
                            </Border.BorderBrush>
                            <StackPanel Margin="5,0,5,0" IsItemsHost="True"
                      KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasDropShadow" Value="true">
                                <Setter TargetName="Border" Property="Padding" Value="0,5,0,5" />
                                <Setter TargetName="Border" Property="CornerRadius" Value="5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HintStyle" TargetType="{x:Type Label}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Label}">
                        <Border CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="Background" Value="#444" />
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="DarkCoolMenuItem" TargetType="{x:Type MenuItem}">
            <Border MinWidth="150" Padding="5" CornerRadius="5" x:Name="templateRoot" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="Icon" Margin="0,0,10,0" Content="{TemplateBinding Icon}" ContentSource="Icon" HorizontalAlignment="Center" Height="16" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center" Width="16"/>
                    <Path x:Name="GlyphPanel" Data="F1M10,1.2L4.7,9.1 4.5,9.1 0,5.2 1.3,3.5 4.3,6.1 8.3,0 10,1.2z" Fill="#FF212121" FlowDirection="LeftToRight" Margin="3" Visibility="Collapsed" VerticalAlignment="Center"/>
                    <ContentPresenter ContentTemplate="{TemplateBinding HeaderTemplate}" Content="{TemplateBinding Header}" Grid.Column="1" ContentStringFormat="{TemplateBinding HeaderStringFormat}" ContentSource="Header" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Icon" Value="{x:Null}">
                    <Setter Property="Visibility" TargetName="Icon" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Visibility" TargetName="GlyphPanel" Value="Visible"/>
                    <Setter Property="Visibility" TargetName="Icon" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" TargetName="templateRoot">
                        <Setter.Value>
                            <SolidColorBrush Color="White" Opacity=".1">

                            </SolidColorBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="#FF26A0DA"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="TextElement.Foreground" TargetName="templateRoot" Value="#FF707070"/>
                    <Setter Property="Fill" TargetName="GlyphPanel" Value="#FF707070"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsHighlighted" Value="True"/>
                        <Condition Property="IsEnabled" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" TargetName="templateRoot" Value="#0A000000"/>
                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="#21000000"/>
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Grid HorizontalAlignment="Center">
        <Grid.ContextMenu>
            <ContextMenu Margin="20" Style="{StaticResource DarkContextMenu}" Name="MainContextMenu" Background="#222">
                <ContextMenu.Effect>
                    <DropShadowEffect Direction="271" BlurRadius="20" Opacity="0.5">

                    </DropShadowEffect>
                </ContextMenu.Effect>
                <ContextMenu.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="border">
                            <TextBlock x:Name="textblock" MinWidth="150" Padding="0" Text="{Binding Header}"/>
                        </Border>



                    </DataTemplate>

                </ContextMenu.ItemTemplate>
                <MenuItem CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Parent}" Click="CloseSomeAppButton_Click"  Name="CloseSomeAppButton" Template="{DynamicResource DarkCoolMenuItem}" Style="{StaticResource DarkMenuItem}"  Padding="0, 0, 0, 0" Background="Transparent" Foreground="#999" Header="Close">
                    <MenuItem.Icon>
                        <TextBlock Foreground="White" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Parent}" Click="OpenNewButton_Click"  Name="OpenNewButton" Template="{DynamicResource DarkCoolMenuItem}" Style="{StaticResource DarkMenuItem}"  Padding="0, 0, 0, 0" Background="Transparent" Foreground="#999" Header="Open new">
                    <MenuItem.Icon>
                        <TextBlock Foreground="White" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Parent}"  Click="RemoveFromDockButton_Click" Name="RemoveFromDockButton" Template="{DynamicResource DarkCoolMenuItem}" Style="{StaticResource DarkMenuItem}"  Padding="0, 0, 0, 0" Background="Transparent" Foreground="#999" Header="Remove from Dock">
                    <MenuItem.Icon>
                        <TextBlock Foreground="White" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" Text="&#xECC9;" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Background="#2d2d2d" Height="2"></Separator>
                <MenuItem Template="{DynamicResource DarkCoolMenuItem}" Style="{StaticResource DarkMenuItem}"  Padding="0, 0, 0, 0" Background="Transparent" Foreground="#999" Header="Lock Dock" Name="LockDockButton" Click="LockDockButton_Click">
                    <MenuItem.Icon>
                        <TextBlock Foreground="White" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" Name="LockDockIcon" Text="&#xE72E;" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Background="#2d2d2d" Height="2"></Separator>
                <MenuItem Template="{DynamicResource DarkCoolMenuItem}" Style="{StaticResource DarkMenuItem}"  Padding="0, 0, 0, 0" Background="Transparent" Foreground="#999" Header="Dock settings" Name="SettingsButton" Click="SettingsButton_Click">
                    <MenuItem.Icon>
                        <TextBlock Foreground="White" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Template="{DynamicResource DarkCoolMenuItem}" Style="{StaticResource DarkMenuItem}" Padding="0, 0, 0, 0" Background="Transparent" Foreground="#999" Header="Restart Dock" Name="RestartButton" Click="RestartButton_Click">
                    <MenuItem.Icon>
                        <TextBlock Foreground="White" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" Text="&#xE777;" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Template="{DynamicResource DarkCoolMenuItem}" Style="{StaticResource DarkMenuItem}" Padding="0, 0, 0, 0" Background="Transparent" Foreground="#999" Header="Exit" Click="MenuItem_Click" Name="ExitButton">
                    <MenuItem.Icon>
                        <TextBlock Foreground="White" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>

        <StackPanel Name="App_full_bg" Opacity="1">
            <Grid>
                <Border CornerRadius="5, 5, 0, 0" Background="#fff" Name="WhiteOverlay" Opacity="0.0" Width="{Binding ActualWidth, ElementName=DockMain}" Height="{Binding ActualHeight, ElementName=DockMain}" VerticalAlignment="Top"></Border>
                <Border CornerRadius="5, 5, 0, 0" Background="#000" Name="BlackOverlay" Opacity="0.1" Width="{Binding ActualWidth, ElementName=DockMain}" Height="{Binding ActualHeight, ElementName=DockMain}" VerticalAlignment="Top"></Border>
                <Border CornerRadius="5, 5, 0, 0" Name="App_bg" Opacity="0.5"  Width="{Binding ActualWidth, ElementName=DockMain}" Height="{Binding ActualHeight, ElementName=DockMain}" VerticalAlignment="Top"></Border>
            </Grid>

        </StackPanel>


        <controls:BlurryUserControl Name="StarDust" Visibility="Hidden" Opacity=".2" BlurContainer="{Binding ElementName=DockIcons}" BlurRadius="30" Height="80" VerticalAlignment="Center">
            <controls:BlurryUserControl.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border CornerRadius="5, 5, 0, 0" Background="White" Width="{Binding ActualWidth, ElementName=DockMain}" Height="{Binding ActualHeight, ElementName=DockMain}">

                        </Border>
                    </VisualBrush.Visual>
                </VisualBrush>
            </controls:BlurryUserControl.OpacityMask>
        </controls:BlurryUserControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Name="DockIcons" >
            <StackPanel Height="{Binding ActualHeight, ElementName=DockMain}" VerticalAlignment="Center" Name="MainPanel" Orientation="Horizontal" HorizontalAlignment="Center">


            </StackPanel>
            <Border Width="2" Margin="10" Background="White" CornerRadius="1" Height="50" Opacity=".2"></Border>
            <StackPanel VerticalAlignment="Center" Name="AIcons" HorizontalAlignment="Center" Orientation="Horizontal">
                <local:DockIcon MouseMove="Img_MouseMove" MouseEnter="Img_MouseEnter" MouseLeave="Img_MouseLeave" Click="DockIcon_Click" Source="icons/explorer_icon.png" Size="56" Label="Explorer"></local:DockIcon>
            </StackPanel>
        </StackPanel>

        <Image MouseDown="Draggable_icon_MouseDown" MouseUp="Draggable_icon_MouseUp"  Name="Draggable_icon" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0" Width="64" Height="64" >
            <Image.Effect>
                <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.3"/>
            </Image.Effect>
        </Image>

    </Grid>
</Window>
