<Window x:Class="FoxDock.Tooltip"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FoxDock"
        mc:Ignorable="d"
        Title="Tooltip" Height="35" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" WindowStyle="None" Background="Transparent" AllowsTransparency="True">
    <Window.Resources>
        <ResourceDictionary Source="Styles/TooltipStyles.xaml" />
    </Window.Resources>
    <Grid>
        <StackPanel Margin="0,0,0,0" Name="fillMe" Height="35" VerticalAlignment="Top">
            <StackPanel.RenderTransform>
                <TranslateTransform X="0" x:Name="TrTransform"></TranslateTransform>
            </StackPanel.RenderTransform>
            <Label Opacity="0" MinWidth="50" Content=""  Padding="10,5,10,15" Margin="0,0,0,0" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Name="app_hint" Foreground="#ddd" Style="{DynamicResource Hint}">
                <Label.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="hintScale"/>
                        <TranslateTransform x:Name="hintTrans" X="0" Y="0"/>
                    </TransformGroup>
                </Label.RenderTransform>
                <Label.RenderTransformOrigin>
                    <Point X="0.5" Y="1"></Point>
                </Label.RenderTransformOrigin>
                <Label.OpacityMask>
                    <VisualBrush TileMode="None" Stretch="None" AlignmentX="Left" AlignmentY="Top">
                        <VisualBrush.Visual>
                            <StackPanel>
                                <Border Width="{Binding ActualWidth, ElementName=app_hint}" Height="26" CornerRadius="0,0,8,8" Background="White"></Border>

                                <Polygon Points="0,0 5,5, 10,0" Stroke="Black" Fill="Black" HorizontalAlignment="Center" />
                            </StackPanel>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Label.OpacityMask>
                
                <Label.Background>
                    <SolidColorBrush>
                        <SolidColorBrush.Color>#333</SolidColorBrush.Color>
                        <SolidColorBrush.Opacity>0.9</SolidColorBrush.Opacity>
                    </SolidColorBrush>
                </Label.Background>
            </Label>

        </StackPanel>
    </Grid>
</Window>
