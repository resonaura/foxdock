        xmlns:local="clr-namespace:FoxDock"
        mc:Ignorable="d"
        Title="Settings" ResizeMode="CanMinimize" fw:AcrylicWindow.NoiseOpacity="0.02" fw:AcrylicWindow.TintColor="#1a1a1a" fw:AcrylicWindow.TintOpacity=".8" fw:AcrylicWindow.Enabled="True" fw:AcrylicWindow.AcrylicWindowStyle="None"  Loaded="SettingsWindow_Loaded" Name="SettingsWindow" Height="520" Width="850" Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="{Binding Foreground.Color, ElementName=SettingsWindow}"/>
        <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="#222"/>
        <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="{Binding Foreground.Color, ElementName=SettingsWindow}"/>
        <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="#222"/>
        <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="{Binding Foreground.Color, ElementName=SettingsWindow}"/>
        <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="#222"/>
        <SolidColorBrush x:Key="MaterialDesignCheckBoxOff" Color="{Binding Foreground.Color, ElementName=SettingsWindow}" Opacity=".2"></SolidColorBrush>
        <SolidColorBrush x:Key="SystemBaseHighColorBrush" Color="#ddd" />
        <SolidColorBrush x:Key="SystemAltHighColorBrush" Color="#ddd" />

        <SolidColorBrush x:Key="MainForegroundBrush" Color="{Binding Foreground.Color, ElementName=SettingsWindow}"></SolidColorBrush>
        <Style x:Key="FocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="2" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CheckBoxStyle1" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <ControlTemplate.Resources>
                            <Storyboard x:Key="OnChecking">
                                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="slider" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="32"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="sliderm" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="32"/>
                                </DoubleAnimationUsingKeyFrames>
                                <ThicknessAnimation Duration="0:0:0.1" Storyboard.TargetName="slider_sl" Storyboard.TargetProperty="(Border.BorderThickness)" From="1" To="0"></ThicknessAnimation>
                                <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="slider_sl" Storyboard.TargetProperty="(Border.Opacity)" From="1" To="0"></DoubleAnimation>
                                <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="slider_bg" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)" From="0" To="1"></DoubleAnimation>
                                <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="sliderm" Storyboard.TargetProperty="(Border.Opacity)" From="0" To="1"></DoubleAnimation>
                            </Storyboard>
                            <Storyboard x:Key="OnUnchecking">
                                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="slider" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="sliderm" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                                <ThicknessAnimation Duration="0:0:0.1" Storyboard.TargetName="slider_sl" Storyboard.TargetProperty="(Border.BorderThickness)" From="0" To="1"></ThicknessAnimation>
                                <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="slider_sl" Storyboard.TargetProperty="(Border.Opacity)" From="0" To="1"></DoubleAnimation>
                                <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="slider_bg" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)" From="1" To="0"></DoubleAnimation>
                                <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="sliderm" Storyboard.TargetProperty="(Border.Opacity)" From="1" To="0"></DoubleAnimation>
                            </Storyboard>
                        </ControlTemplate.Resources>

                        <DockPanel Margin="0,2,0,0" x:Name="dockPanel">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Content="{TemplateBinding Content}" ContentStringFormat="{TemplateBinding ContentStringFormat}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="0,0,20,0" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            <Border Background="{TemplateBinding Property=Background}" x:Name="slider_bg" CornerRadius="10" Height="20">
                                <Grid>
                                    <Border CornerRadius="10" BorderThickness="1" Height="20" x:Name="slider_sl" BorderBrush="{DynamicResource MainForegroundBrush}">
                                    </Border>
                                    <Grid Margin="3,0,3,0" Width="45" Background="Transparent">
                                    
                                    <TextBlock Visibility="Hidden" Text="ON" TextWrapping="Wrap" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right" Margin="0,0,3,0"/>
                                    <TextBlock Visibility="Hidden" HorizontalAlignment="Left" Margin="2,0,0,0" FontSize="12" FontWeight="Bold" Text="OFF" TextWrapping="Wrap"/>
                                    <Border BorderThickness="0" BorderBrush="Transparent" HorizontalAlignment="Left" x:Name="slider" Height="12" Width="12" VerticalAlignment="Center" CornerRadius="100" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                <SkewTransform AngleX="0" AngleY="0"/>
                                                <RotateTransform Angle="0"/>
                                                <TranslateTransform X="0" Y="0"/>
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding Foreground.Color, ElementName=SettingsWindow}"></SolidColorBrush>
                                        </Border.Background>
                                    </Border>
                                        <Border Opacity="0" BorderThickness="0" BorderBrush="Transparent" HorizontalAlignment="Left" x:Name="sliderm" Height="12" Width="12" VerticalAlignment="Center" CornerRadius="100" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    <SkewTransform AngleX="0" AngleY="0"/>
                                                    <RotateTransform Angle="0"/>
                                                    <TranslateTransform X="0" Y="0"/>
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                            <Border.Background>
                                                <SolidColorBrush Color="White"></SolidColorBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Grid>
                                
                            </Border>
                        </DockPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource OnUnchecking}" x:Name="OnUnchecking_BeginStoryboard"/>
                                </Trigger.ExitActions>
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource OnChecking}" x:Name="OnChecking_BeginStoryboard"/>
                                </Trigger.EnterActions>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
